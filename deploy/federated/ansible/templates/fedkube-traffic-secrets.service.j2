[Unit]
Description=Fetch FedKube traffic-generator secrets through VM identity
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RuntimeDirectory=fedkube-secrets
RuntimeDirectoryMode=0750
ExecStart=/usr/local/sbin/fedkube-fetch-traffic-secrets
RemainAfterExit=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/fedkube-secrets

[Install]
WantedBy=multi-user.target
