# =====================================================
# IoT-23 FL+GNN — Giai đoạn 1
# =====================================================

# --- Dữ liệu thô & file trung gian ---
/data/
phase3_monitoring/flow_feeder/sample_data/
checkpoints/
artifacts/*          # ignore mọi thứ TRONG artifacts/
/artifacts/data_cache/
# Prepared graphs, run events, metrics, and checkpoints.
artifacts/phase2/

# --- Ngoại lệ: track kết quả cuối cùng GĐ1 ---
!artifacts/phase1_results/
!artifacts/eda_summary.csv
artifacts/phase1_results/*   # re-ignore tất cả trong phase1_results/
# cho phép lại các file CSV + confusion matrix PNG:
!artifacts/phase1_results/results_summary.csv
!artifacts/phase1_results/phase_a_*.csv
!artifacts/phase1_results/phase_b_*.csv
!artifacts/phase1_results/checkpoints/
artifacts/phase1_results/checkpoints/*   # re-ignore nội dung checkpoints/
!artifacts/phase1_results/checkpoints/*.png  # cho phép PNG confusion matrix

# --- Artifact nhị phân ---
*.pt
*.pth
*.parquet
*.pkl
*.joblib
*.npy
*.npz

# --- Môi trường ảo ---
.venv/
venv/
env/

# --- Python cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- IDE / editor ---
.idea/
.vscode/
*.swp
*.swo

# --- OS rác ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Log & file tạm ---
*.log
*.tmp
*.bak
nohup.out

# --- Secrets / Env ---
.env
.env.*
!.env.example

# --- Jupyter / Notebooks ---
.ipynb_checkpoints/

# --- Explicitly allowed files ---
!CLAUDE.md
!README.md
# Harness core maintenance binary
scripts/bin/harness
scripts/bin/harness.exe

# --- Phase 1 clean: report and deployment allowlist ---
# Raw predictions and complete per-seed/LOSO bundles are reproducibility
# artifacts, not source-controlled files. They are backed up outside Git.
/artifacts/phase1_clean/seed-*/
/artifacts/phase1_clean/**/predictions.csv

# Keep the small, report-ready deliverables and provenance files.
!/artifacts/phase1_clean/
!/artifacts/phase1_clean/report_analysis/
!/artifacts/phase1_clean/report_analysis/**
!/artifacts/phase1_clean/dataset_manifest.json
!/artifacts/phase1_clean/dataset_manifest.csv
!/artifacts/phase1_clean/config_phase1_train.yaml
!/artifacts/phase1_clean/remote_git_status.txt
!/artifacts/phase1_clean/remote_worktree.diff
!/artifacts/phase1_clean/provenance_sha256.txt

# Keep only the pooled seed-42 runtime bundle for the Phase 3 handoff.
!/artifacts/phase1_clean/seed-42-full/
/artifacts/phase1_clean/seed-42-full/*
!/artifacts/phase1_clean/seed-42-full/pooled-seed-42/
!/artifacts/phase1_clean/seed-42-full/pooled-seed-42/model.pt
!/artifacts/phase1_clean/seed-42-full/pooled-seed-42/preprocessor.pkl
!/artifacts/phase1_clean/seed-42-full/pooled-seed-42/schema.json
!/artifacts/phase1_clean/seed-42-full/pooled-seed-42/labels.json
!/artifacts/phase1_clean/seed-42-full/pooled-seed-42/metadata.json
!/artifacts/phase1_clean/seed-42-full/pooled-seed-42/metrics.json
!/artifacts/phase1_clean/seed-42-full/pooled-seed-42/split_manifest.json
